# .gitignore for portfolio project
# Node modules
node_modules/

# Environment variables
.env
.env.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# Prisma generated files
prisma/.env
prisma/migrations/*/README.md

# Build output
.next/
out/
dist/

# VSCode settings
.vscode/

# Coverage
coverage/

# Misc
*.local
*.sublime-workspace
*.sublime-project

# Ignore database files
*.sqlite
*.db

# Ignore test snapshots
__snapshots__/

# Ignore IDE folders
.idea/

# Ignore old backups
*.bak

# Ignore temporary files
*.tmp
*.swp

# Ignore seed output
prisma/seed-output/

# Ignore any other sensitive or unnecessary files
secret.*
*.key
*.pem
*.crt

# Ignore package lock files if not needed
# package-lock.json
yarn.lock

# Ignore coverage reports
coverage/

# Ignore local scripts
scripts/local/

# Ignore project instructions file
INSTRUCTIONS_CLAUDE_CODE.md
